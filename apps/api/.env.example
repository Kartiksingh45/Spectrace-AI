# Cloud Postgres connection string (Neon or Supabase free tier).
# Example Neon format: postgresql+psycopg://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000

# Session cookie attributes. Leave as-is for local dev (frontend/API share "localhost" as their
# site, just different ports). If the frontend and API are deployed on different domains (e.g.
# Cloudflare Pages + Render), set COOKIE_SAMESITE=none and COOKIE_SECURE=true - otherwise the
# browser silently drops the session cookie on every cross-site request after login.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Gemini API key (get one free at https://aistudio.google.com/apikey) - powers the agent's LLM
# calls (classification, plan generation, the tool loop). Does NOT power embeddings - see
# JINA_API_KEY below.
GEMINI_API_KEY=
# GEMINI_MODEL_NAME=gemini-3.5-flash-lite

# Jina AI API key (get one free, no card required, at https://jina.ai/embeddings) - powers
# embeddings. Not Gemini: embeddings used to run on a local sentence-transformers/PyTorch model,
# which pushed peak memory past what a constrained host (e.g. Render's free 512MB tier) could
# handle; switching to Gemini's embedding API avoided that, but its free-tier daily quota proved
# too tight for real ingestion traffic. Jina's free tier has a much more generous quota.
JINA_API_KEY=

# Ingestion / retrieval (defaults shown - override only if you need to)
EMBEDDING_MODEL_NAME=jina-embeddings-v3
EMBEDDING_DIMENSIONS=384
# The cross-encoder reranker loads a PyTorch model - on a memory-constrained host set this to
# false - retrieval still works fine via hybrid vector+keyword ranking alone, just without the
# extra reordering pass. Requires the (no longer installed by default) sentence-transformers
# package if enabled - see requirements.txt.
ENABLE_RERANKER=true
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_DOCUMENT_SIZE_MB=20
MAX_ZIP_FILES=2000
MAX_ZIP_UNCOMPRESSED_MB=200
GITHUB_IMPORT_MAX_DOWNLOAD_MB=50
MIN_RELEVANCE_SCORE=0.2

# Forgot-password emails, sent via Resend's HTTP API (free tier, no card required - sign up at
# https://resend.com, create an API key). Left blank, forgot-password still responds normally but
# no email actually goes out (logged as a warning instead). RESEND_FROM_EMAIL defaults to Resend's
# own shared sandbox sender, which can send to any address without verifying your own domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
