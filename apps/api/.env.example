# Cloud Postgres connection string (Neon or Supabase free tier).
# Example Neon format: postgresql+psycopg://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000

# Session cookie attributes. Leave as-is for local dev (frontend/API share "localhost" as their
# site, just different ports). If the frontend and API are deployed on different domains (e.g.
# Cloudflare Pages + Render), set COOKIE_SAMESITE=none and COOKIE_SECURE=true - otherwise the
# browser silently drops the session cookie on every cross-site request after login.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Gemini API key (get one free at https://aistudio.google.com/apikey) - powers the agent's LLM
# calls AND embeddings (embeddings used to run on a local sentence-transformers/PyTorch model,
# but that pushed peak memory past what a constrained host, e.g. Render's free 512MB tier, could
# handle - switched to Gemini's own embedding API, which needs no extra memory footprint)
GEMINI_API_KEY=
# GEMINI_MODEL_NAME=gemini-3.5-flash-lite

# Ingestion / retrieval (defaults shown - override only if you need to)
EMBEDDING_MODEL_NAME=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=384
# The cross-encoder reranker loads a PyTorch model - on a memory-constrained host set this to
# false - retrieval still works fine via hybrid vector+keyword ranking alone, just without the
# extra reordering pass. Requires the (no longer installed by default) sentence-transformers
# package if enabled - see requirements.txt.
ENABLE_RERANKER=true
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_DOCUMENT_SIZE_MB=20
MAX_ZIP_FILES=2000
MAX_ZIP_UNCOMPRESSED_MB=200
GITHUB_IMPORT_MAX_DOWNLOAD_MB=50
MIN_RELEVANCE_SCORE=0.2
