# Cloud Postgres connection string (Neon or Supabase free tier).
# Example Neon format: postgresql+psycopg://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000

# Reserved for later phases (ingestion / agent) - not used yet
GROQ_API_KEY=
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
